# Copy to .env (repo root). NEVER commit .env.

ENV=production
POSTGRES_PASSWORD=change-me-long-random

# Encrypts the wallet key you enter in the website. Generate once and back it up:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing it means re-entering the wallet; leaking it + the DB exposes the key.
MASTER_KEY=
# Signs login sessions: 32+ random chars, e.g.  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Password for the 'admin' login, used to create the account on first boot only.
ADMIN_PASSWORD=

# Server-side kill switch for real orders. Live trading needs this AND the in-app toggle
# (which itself needs the paper-trading acceptance criteria to pass).
ALLOW_LIVE_TRADING=false

# Optional fallback if you'd rather not enter the wallet in the website:
PRIVATE_KEY=
FUNDER_ADDRESS=
SIGNATURE_TYPE=1

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
