# Copy to .env and fill in. NEVER commit .env or share it with anyone.

# ---- Trading mode ----
# false = paper trading (simulated fills against the real order book, no key needed)
# true  = real orders on Polymarket with your wallet
LIVE_TRADING=false

# ---- Wallet (only needed when LIVE_TRADING=true) ----
# Use a NEW wallet that has never been pasted into any website.
# Export the private key of the Polymarket account (polymarket.com -> Settings -> Export private key)
PRIVATE_KEY=
# Your Polymarket profile/deposit address (the "proxy wallet" that holds your USDC).
FUNDER_ADDRESS=
# 1 = email / Magic login account, 2 = browser-wallet (MetaMask etc.) account, 0 = plain EOA with no proxy
SIGNATURE_TYPE=1

# ---- Dashboard ----
HOST=127.0.0.1
PORT=8787
# Required if HOST is not localhost (e.g. on a VPS). Pick a long random string.
DASHBOARD_TOKEN=
# Start trading automatically when the server boots (useful under systemd)
AUTOSTART=false
